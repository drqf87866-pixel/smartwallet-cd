{
  "name": "smartwallet-cd",
  "version": "0.1.0",
  "private": true,
  "description": "Einnahmen-Ausgaben-Dashboard für Paare – Cloudflare Worker + Hono + D1",
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/assets/app.css --minify",
    "db:init": "wrangler d1 execute smartwallet-cd-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute smartwallet-cd-db --remote --file=./schema.sql",
    "db:reset": "wrangler d1 execute smartwallet-cd-db --local --file=./scripts/reset.sql && npm run db:init",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
